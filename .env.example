# Copia a .env y completa los valores locales. No uses secretos reales en este
# archivo ni lo edites con credenciales que vayan a versionarse.

# PostgreSQL para tools/cli.py
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario
DB_USER=inventario
DB_PASSWORD=

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/inventario
SPRING_DATASOURCE_USERNAME=inventario
SPRING_DATASOURCE_PASSWORD=
# Clave aleatoria base64 de al menos 32 bytes; no la compartas ni la versionas.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
SPRING_PROFILES_ACTIVE=local

# Frontend (Vite)
VITE_API_URL=http://localhost:8080

# Docker Compose (docker compose up --build). Usa DB_NAME, DB_USER, DB_PASSWORD,
# JWT_SECRET, ADMIN_EMAIL y ADMIN_PASSWORD de este archivo; dentro de la red de
# Docker la base es el servicio "db". CORS y la URL de la API del frontend se
# derivan de estos puertos publicados en el equipo.
BACKEND_PORT=8080
FRONTEND_PORT=8081
