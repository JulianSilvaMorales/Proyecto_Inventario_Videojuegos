{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inventario.local/schemas/model.schema.json",
  "title": "Modelo conceptual del inventario",
  "type": "object",
  "additionalProperties": false,
  "required": ["modulo", "entidades"],
  "properties": {
    "modulo": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "descripcion": {
      "type": "string",
      "minLength": 1
    },
    "entidades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entidad"
      }
    }
  },
  "$defs": {
    "nombre": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "referencia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entidad", "campo"],
      "properties": {
        "entidad": {
          "$ref": "#/$defs/nombre"
        },
        "campo": {
          "$ref": "#/$defs/nombre"
        }
      }
    },
    "validacion_frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campo"],
      "properties": {
        "campo": {
          "$ref": "#/$defs/nombre"
        },
        "valor": {
          "type": "string"
        },
        "requeridos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nombre"
          }
        },
        "requiere_verdadero": {
          "type": "boolean"
        },
        "solo_creacion": {
          "type": "boolean"
        }
      }
    },
    "campo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nombre", "tipo"],
      "properties": {
        "nombre": {
          "$ref": "#/$defs/nombre"
        },
        "tipo": {
          "enum": [
            "uuid",
            "texto",
            "entero",
            "decimal",
            "booleano",
            "fecha",
            "fecha_hora_utc",
            "json"
          ]
        },
        "descripcion": {
          "type": "string",
          "minLength": 1
        },
        "pk": {
          "type": "boolean"
        },
        "obligatorio": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "precision": {
          "type": "integer",
          "minimum": 1
        },
        "escala": {
          "type": "integer",
          "minimum": 0
        },
        "valores": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ref": {
          "$ref": "#/$defs/referencia"
        },
        "default": {},
        "solo_lectura": {
          "type": "boolean"
        }
      }
    },
    "entidad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nombre",
        "descripcion",
        "inmutable",
        "generar_crud",
        "campos",
        "etiquetas"
      ],
      "properties": {
        "nombre": {
          "$ref": "#/$defs/nombre"
        },
        "descripcion": {
          "type": "string",
          "minLength": 1
        },
        "inmutable": {
          "type": "boolean"
        },
        "generar_crud": {
          "type": "boolean"
        },
        "solo_desactivar": {
          "type": "boolean"
        },
        "validaciones_frontend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validacion_frontend"
          }
        },
        "campos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/campo"
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nombre"
            }
          }
        },
        "unicos": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nombre"
            }
          }
        },
        "etiquetas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["es", "en"],
          "properties": {
            "es": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
